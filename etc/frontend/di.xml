<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Layout\File\Collector\Aggregated">
        <plugin name="oocs_lynxtheme_filter_layout_files" type="OOCS\LynxTheme\Plugin\FilterLayoutFiles" sortOrder="10"/>
    </type>
    <!--
        Visitor logging writes customer_visitor on every unsafe request; under lynx/* the only one is
        checkout/process. Keyed by route name; LynxPageBuilder\Controller\Router turns it off for previews itself.
    -->
    <type name="Magento\Customer\Model\Visitor">
        <arguments>
            <argument name="ignores" xsi:type="array">
                <item name="lynx" xsi:type="string">lynx</item>
            </argument>
        </arguments>
    </type>
    <!--
        The theme fallback: hands the pages listed in lynx_fallback/general/actions to a Magento theme when turned
        on. On DesignInterface, so the theme is named before the translation dictionary is built. See the plugin.
    -->
    <type name="Magento\Framework\View\DesignInterface">
        <plugin name="oocs_lynxtheme_fallback_design" type="OOCS\LynxTheme\Plugin\FallbackDesign" sortOrder="10"/>
    </type>
</config>
